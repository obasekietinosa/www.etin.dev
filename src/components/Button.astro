---
import clsx from "clsx";

export interface Props {
  as?: string;
  size?: "lg" | "sm" | "default";
  href?: string;
  class?: string;
  variant?: "primary" | "secondary" | "ghost";
  target?: string;
  rel?: string;
  [prop: string]: any;
}

const {
  class: className,
  size = "default",
  href,
  variant = "primary",
  ...props
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center font-mono font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 whitespace-nowrap rounded-sm";

const variants = {
  primary:
    "group relative bg-accent text-accent-foreground border border-accent hover:bg-accent/90 gap-2 active:translate-y-px",
  secondary:
    "border border-border bg-card text-foreground hover:border-accent hover:text-accent active:translate-y-px",
  ghost:
    "group relative text-muted-foreground hover:text-accent bg-transparent active:translate-y-px border-0",
};

const sizes = {
  sm: {
    primary: "text-xs px-3.5 py-2",
    secondary: "text-xs px-3.5 py-2",
    ghost: "text-xs px-2.5 py-1.5",
  },
  default: {
    primary: "text-xs md:text-sm px-5 py-2.5",
    secondary: "text-xs md:text-sm px-5 py-2.5",
    ghost: "text-xs md:text-sm px-3 py-2",
  },
  lg: {
    primary: "text-sm md:text-base px-7 py-3.5",
    secondary: "text-sm md:text-base px-7 py-3.5",
    ghost: "text-sm md:text-base px-5 py-3",
  },
};

const selectedSize = sizes[size as keyof typeof sizes] || sizes.default;
const sizeClasses = selectedSize[variant as keyof typeof selectedSize] || selectedSize.primary;

const classes = clsx(baseClasses, variants[variant], sizeClasses, className);
---

<>
  {
    href ? (
      <a href={href} class={classes} {...props}>
        <slot />
        {variant === "ghost" && (
          <span class="absolute bottom-1 left-3 right-3 h-px bg-accent origin-left scale-x-0 transition-transform duration-200 group-hover:scale-x-100" />
        )}
      </a>
    ) : (
      <button class={classes} {...props}>
        <slot />
        {variant === "ghost" && (
          <span class="absolute bottom-1 left-3 right-3 h-px bg-accent origin-left scale-x-0 transition-transform duration-200 group-hover:scale-x-100" />
        )}
      </button>
    )
  }
</>
