---
import type { Note } from "../../domains/Notes";
import Badge from "../Badge.astro";

interface Props {
  note: Note;
}

const { note } = Astro.props;
---

<li class="group block py-8 border-t border-border-subtle first:border-t-0">
  <a href={`/note/${note.slug}`} class="block">
    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-4 mb-3">
      <h3 class="text-2xl md:text-3xl font-serif font-semibold tracking-tight group-hover:text-accent transition-colors">
        {note.title}
      </h3>
      <div class="flex flex-wrap gap-2 shrink-0">
        {note.tags.map((tag) => <Badge key={tag.name} {...tag} />)}
      </div>
    </div>
    <p class="text-base md:text-lg text-muted-foreground leading-relaxed max-w-3xl">
      {note.preview}
    </p>
    <div class="mt-4 flex items-center gap-2 text-xs font-mono text-accent uppercase tracking-widest opacity-80 group-hover:opacity-100 transition-all">
      <span>Read Article</span>
      <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
    </div>
  </a>
</li>
