---
import cx from "clsx";
import type { Tag } from "../domains/Tags";

type BadgeProps = {
  icon?: string;
  name: string;
  class?: string;
  color?: Tag["color"];
  [prop: string]: any;
};

const { class: className, icon, name, color, ...props } = Astro.props;
---

<div
  class={cx(
    "inline-flex items-center gap-1.5 border border-patina/60 rounded-sm px-2.5 py-0.5 bg-patina-surface text-patina-foreground font-mono text-xs uppercase tracking-wider",
    className
  )}
  {...props}
>
  {icon && <span class="text-accent">{icon}</span>}
  <span>{name}</span>
</div>
