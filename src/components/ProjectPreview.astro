---
import type { Project } from "../domains/Projects";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="group plaque-frame rounded-md p-6 md:p-8 grid md:grid-cols-12 gap-8 md:gap-10 items-center transition-colors duration-200 hover:border-accent/60">
  <!-- Corner Bronze Rivets -->
  <span class="plaque-rivet absolute top-2.5 left-2.5"></span>
  <span class="plaque-rivet absolute top-2.5 right-2.5"></span>
  <span class="plaque-rivet absolute bottom-2.5 left-2.5"></span>
  <span class="plaque-rivet absolute bottom-2.5 right-2.5"></span>

  <!-- Image Column -->
  <div class="md:col-span-5 relative aspect-video overflow-hidden rounded-sm border border-border bg-muted">
    <img
      class="h-full w-full object-cover sepia-[0.35] contrast-105 brightness-95 transition-all duration-500 group-hover:sepia-0 group-hover:brightness-100 group-hover:scale-105"
      src={project.image}
      alt={`Screenshot of ${project.title}`}
    />
  </div>

  <!-- Content Column -->
  <div class="md:col-span-7 flex flex-col items-start">
    <div class="mb-3">
      <Badge {...project.status} />
    </div>

    <h3 class="text-3xl md:text-4xl font-serif font-semibold tracking-tight mb-3 group-hover:text-accent transition-colors">
      <a href={`/project/${project.slug}`}>
        {project.title}
      </a>
    </h3>

    <p class="text-base md:text-lg text-muted-foreground mb-6 leading-relaxed">
      {project.description}
    </p>

    <div class="w-full pt-4 border-t border-border-subtle flex items-center justify-between">
      <Button variant="primary" size="sm" href={`/project/${project.slug}`}>
        View Project &rarr;
      </Button>
    </div>
  </div>
</div>
