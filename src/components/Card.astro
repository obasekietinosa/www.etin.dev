---
import clsx from "clsx";

interface Props {
  class?: string;
  bordered?: boolean;
  [prop: string]: any;
}

const { class: className, bordered = true, ...props } = Astro.props;
---

<div
  class={clsx(
    "relative p-6 md:p-10 rounded-md transition-colors duration-200",
    {
      "plaque-frame hover:border-accent/60": bordered,
    },
    className
  )}
  {...props}
>
  {bordered && (
    <>
      <span class="plaque-rivet absolute top-2.5 left-2.5" />
      <span class="plaque-rivet absolute top-2.5 right-2.5" />
      <span class="plaque-rivet absolute bottom-2.5 left-2.5" />
      <span class="plaque-rivet absolute bottom-2.5 right-2.5" />
    </>
  )}
  <slot />
</div>
