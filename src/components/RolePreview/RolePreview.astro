---
import { formatRoleDate, type Role } from "../../domains/Roles";
import Button from "../Button.astro";

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<div class="relative pl-8 md:pl-0 md:grid md:grid-cols-[1fr_24px_3fr] gap-4 md:gap-8 group">
  <!-- Mobile Timeline Line & Bronze Stud -->
  <div class="absolute left-1.5 top-0 h-full w-px bg-border md:hidden"></div>
  <div class="absolute left-0 top-2.5 h-3 w-3 rounded-full bg-accent ring-4 ring-background md:hidden"></div>

  <!-- Left Col: Dates (Desktop) -->
  <div class="hidden md:block text-right pt-1.5">
    <div class="text-xs font-mono text-muted-foreground uppercase tracking-wider">
      {formatRoleDate(role.startDate)} &mdash; {role.endDate ? formatRoleDate(role.endDate) : "Present"}
    </div>
  </div>

  <!-- Center Col: Bronze Timeline Spine & Stud (Desktop) -->
  <div class="hidden md:flex flex-col items-center relative">
    <div class="w-3 h-3 rounded-full bg-accent ring-4 ring-background z-10 mt-2 transition-transform duration-200 group-hover:scale-125"></div>
    <div class="w-px flex-1 bg-border"></div>
  </div>

  <!-- Right Col: Role Content -->
  <div class="pb-12 border-b border-border-subtle last:border-0">
    <!-- Company & Verdigris Patina Pill -->
    <div class="flex flex-wrap items-center gap-2.5 mb-2">
      <span class="text-sm font-mono uppercase tracking-wider text-accent font-medium">
        {role.company}
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-patina-surface text-patina-foreground border border-patina/50">
        {role.endDate ? "Archive" : "Active Role"}
      </span>
    </div>

    <!-- Mobile Date -->
    <div class="md:hidden mb-2 text-xs font-mono text-muted-foreground uppercase tracking-wider">
      {formatRoleDate(role.startDate)} &mdash; {role.endDate ? formatRoleDate(role.endDate) : "Present"}
    </div>

    <h3 class="text-2xl md:text-3xl font-serif font-semibold tracking-tight mb-1.5 group-hover:text-accent transition-colors">
      <a href={`/role/${role.slug}`} class="focus:outline-none">
        <span class="absolute inset-0 md:hidden"></span>
        {role.title}
      </a>
    </h3>
    {role.subtitle && <p class="text-base italic font-serif text-muted-foreground mb-3">{role.subtitle}</p>}
    <p class="text-base leading-relaxed text-muted-foreground mb-5 line-clamp-3">
      {role.description}
    </p>
    <div class="hidden md:block">
      <Button variant="ghost" size="sm" href={`/role/${role.slug}`} class="pl-0">
        Read more &rarr; <span class="sr-only">about {role.title}</span>
      </Button>
    </div>
  </div>
</div>
