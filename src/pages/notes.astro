---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import NotePreviewList from "../components/NotePreview/NotePreviewList.astro";
import NotePreview from "../components/NotePreview/NotePreview.astro";
import { getNotes } from "../domains/Notes";

const notes = await getNotes();
---

<Layout title="Writing — Etin Obaseki">
  <main>
    <section>
      <header class="mb-12">
        <h1 class="text-5xl md:text-6xl font-serif font-semibold tracking-tight mb-4">
          Writing
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed">
          I like to write. This section of my website contains writing from different spheres of my life.
        </p>
        <div class="divider-guilloche mt-10"></div>
      </header>

      <Card>
        <NotePreviewList class="space-y-0">
          {notes.map((note) => <NotePreview note={note} />)}
        </NotePreviewList>
      </Card>
    </section>
  </main>
</Layout>
