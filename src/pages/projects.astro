---
import Layout from "../layouts/Layout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import { getProjects } from "../domains/Projects";

const projects = await getProjects();
---

<Layout title="Projects — Etin Obaseki">
  <main>
    <section>
      <header class="mb-12">
        <h1 class="text-5xl md:text-6xl font-serif font-semibold tracking-tight mb-4">
          Projects
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed">
          I aspire to regularly do cool things and talk about them here.
          Here is a complete list of my projects.
        </p>
        <div class="divider-guilloche mt-10"></div>
      </header>

      <div class="space-y-8">
        {projects.map((project) => <ProjectPreview project={project} />)}
      </div>
    </section>
  </main>
</Layout>
