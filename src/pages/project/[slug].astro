---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import NotePreviewList from "../../components/NotePreview/NotePreviewList.astro";
import NotePreview from "../../components/NotePreview/NotePreview.astro";
import { getProjects } from "../../domains/Projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Etin Obaseki`}>
  <main>
    <section>
      <header class="mb-12">
        <Button variant="secondary" size="sm" href="/projects" class="mb-8 inline-block">
          &larr; Back to projects
        </Button>

        <div class="grid md:grid-cols-12 gap-8 md:gap-10 items-center">
          <div class="md:col-span-6 plaque-frame p-3 rounded-md">
            <img
              class="w-full rounded-sm border border-border object-cover"
              src={project.image}
              alt={`Image for ${project.title}`}
            />
          </div>
          <div class="md:col-span-6">
            <h1 class="text-4xl md:text-5xl font-serif font-semibold tracking-tight text-foreground mb-4">
              {project.title}
            </h1>
            <div class="mb-5">
              <Badge {...project.status} />
            </div>
            <div class="flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="bg-card border border-border text-muted-foreground px-2.5 py-1 rounded-sm text-xs font-mono uppercase tracking-wider">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="divider-guilloche mt-12"></div>
      </header>

      <Card>
        <div class="prose prose-lg dark:prose-invert max-w-none">
          <p class="whitespace-pre-line text-foreground/90 leading-relaxed">{project.description}</p>
        </div>
      </Card>

      {
        project.notes && project.notes.length > 0 && (
          <div class="mt-16">
            <h2 class="text-3xl font-serif font-semibold text-foreground mb-6">
              Related Notes
            </h2>
            <Card>
              <NotePreviewList class="space-y-0">
                {project.notes.map((note) => (
                  <NotePreview note={note} />
                ))}
              </NotePreviewList>
            </Card>
          </div>
        )
      }
    </section>
  </main>
</Layout>
