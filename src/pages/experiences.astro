---
import Layout from "../layouts/Layout.astro";
import RolePreview from "../components/RolePreview/RolePreview.astro";
import RolePreviewLayout from "../components/RolePreview/RolePreviewLayout.astro";
import Card from "../components/Card.astro";
import { getRoles } from "../domains/Roles";

const roles = await getRoles();
---

<Layout title="Professional Experiences — Etin Obaseki">
  <main>
    <section>
      <header class="mb-12">
        <h1 class="text-5xl md:text-6xl font-serif font-semibold tracking-tight mb-4">
          Professional Experiences
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed">
          A complete look at the roles I've held over the years. Each stop has
          helped me grow into the engineer I am today.
        </p>
        <div class="divider-guilloche mt-10"></div>
      </header>

      <Card>
        <RolePreviewLayout remainingCount={0}>
          {roles.map((role) => (
            <RolePreview role={role} />
          ))}
        </RolePreviewLayout>
      </Card>
    </section>
  </main>
</Layout>
